<Window x:Class="QaRunner.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:QaRunner.Desktop" Title="정보지킴 QA" Width="1120" Height="740" MinWidth="840" MinHeight="500"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
 Foreground="{StaticResource InkBrush}" Background="{StaticResource AppBackgroundBrush}" UseLayoutRounding="True" Style="{StaticResource DesktopWindow}">
 <Window.Resources>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="TileValue" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="SummaryTile" TargetType="Border"><Setter Property="Padding" Value="16,12"/></Style>
 </Window.Resources>
 <Grid Background="{StaticResource AppBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <local:WindowTitleBar x:Name="TitleBar"/>
  <Grid x:Name="WorkspaceViewport" Grid.Row="1" ClipToBounds="True"><Grid x:Name="WorkspaceRoot">
   <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Visibility="Collapsed" Background="{StaticResource ContextBarBrush}" BorderBrush="{StaticResource ContextLineBrush}" BorderThickness="0,0,0,2">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ui:Button x:Name="WorkspaceButton" Style="{StaticResource WorkspaceButton}" Click="OpenWorkspace_Click" Background="{StaticResource ContextWorkspaceBrush}" BorderBrush="{StaticResource ContextLineBrush}" BorderThickness="1" Padding="17,8" HorizontalContentAlignment="Left" local:UsageHelp.Key="workspace"><StackPanel><TextBlock Text="작업 공간" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="정보지킴 QA" FontWeight="Bold" FontSize="14"/></StackPanel></ui:Button>
     <StackPanel Grid.Column="1" Margin="19,6" VerticalAlignment="Center"><TextBlock Text="QA 작업 공간" FontSize="14" FontWeight="Bold"/><TextBlock Text="시험 문자부터 보고서까지 한곳에서 볼 수 있어요." Foreground="{StaticResource InkBrush}" FontSize="11"/></StackPanel>
     <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,4" Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="로컬 QA" FontSize="11"/></Border>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel>
     <ui:Button DockPanel.Dock="Bottom" Command="{x:Static ApplicationCommands.Help}" Appearance="Transparent" Margin="8" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" local:UsageHelp.Key="help"><StackPanel><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="사용 안내" FontSize="12" Margin="0,8,0,0"/></StackPanel></ui:Button>
     <StackPanel x:Name="NavigationBar" Margin="0,8,0,0">

    <RadioButton x:Name="OverviewNav" GroupName="Page" Content="시작하기" Tag="overview" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" IsChecked="True" local:UsageHelp.Key="overview"/>
    <RadioButton x:Name="RunNav" GroupName="Page" Content="시험하기" Tag="run" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="run-page"/>
    <RadioButton x:Name="CasesNav" GroupName="Page" Content="시험 문자" Tag="cases" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="case-page"/>
    <RadioButton x:Name="AiNav" GroupName="CaseContent" Content="AI 문자 만들기" Visibility="Collapsed" Tag="ai" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="ai-page"/>
    <RadioButton x:Name="ReviewNav" GroupName="CaseContent" Content="정답 검토" Visibility="Collapsed" Tag="review" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="review-page"/>
    <RadioButton x:Name="TeamNav" GroupName="Page" Content="공유 기록" Tag="team" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="team"/>
    <RadioButton x:Name="ReportsNav" GroupName="Page" Content="실행 기록" Tag="reports" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="reports"/>
    <RadioButton x:Name="SettingsNav" GroupName="Page" Content="설정" Tag="settings" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="settings"/>
     </StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="HomeQuestions" Margin="0,0,0,32">
      <!-- Adapted from WPF UI 2.0.3 Demo Dashboard. See THIRD-PARTY-NOTICES.txt. -->
      <!-- 첫 화면에서 시험 카드까지 보이도록 배경 영역은 280으로 줄였다. -->
      <Border x:Name="HomeHero" Height="280" CornerRadius="8,0,0,0">
       <Border.Background><SolidColorBrush Color="#202631"/></Border.Background>
       <Grid>
        <Border CornerRadius="8,0,0,0"><Border.Background><RadialGradientBrush><GradientStop Color="#1F000000" Offset="0"/><GradientStop Color="#4F000000" Offset="1"/></RadialGradientBrush></Border.Background></Border>
        <TextBlock Text="시작하기" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="32,28,32,0" VerticalAlignment="Top"/>
        <StackPanel Margin="32,0,32,28" VerticalAlignment="Bottom" MaxWidth="570" HorizontalAlignment="Left">
         <TextBlock Text="정보지킴 자동화 시험" Foreground="#D9FFFFFF" FontSize="13"/>
         <TextBlock Text="자동화 QA" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,4"/>
         <TextBlock Text="시험을 실행하고 결과를 한곳에서 확인하세요." Foreground="#E0FFFFFF" FontSize="14" TextWrapping="Wrap"/>
         <TextBlock x:Name="HomeRecommendationTitle" Foreground="#D9FFFFFF" FontSize="13" Margin="0,8,0,0"/>
         <ui:Button x:Name="PrepareHomeRunButton" Content="실행 조건 확인 →" Click="PrepareHomeRun_Click" Style="{StaticResource SecondaryButton}" Appearance="Transparent" Foreground="White" Background="#18000000" BorderBrush="#40FFFFFF" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock Text="정보지킴 QA · WPF UI Gallery" Foreground="#9FFFFFFF" FontSize="12" Margin="16,12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
       </Grid>
      </Border>
      <UniformGrid x:Name="HomeSuiteCards" Columns="4" Margin="26,24,26,0">
       <RadioButton x:Name="HomeVerdictChoice" GroupName="HomeSuite" IsChecked="True" Tag="verdict" Checked="HomeSuite_Checked" Style="{StaticResource QuestionChoice}" local:UsageHelp.Key="verdict"><StackPanel><TextBlock Text="문자 판정" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="예상 정답 비교" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
       <RadioButton x:Name="HomePipelineChoice" GroupName="HomeSuite" Tag="pipeline" Checked="HomeSuite_Checked" Style="{StaticResource QuestionChoice}" local:UsageHelp.Key="pipeline"><StackPanel><TextBlock Text="데이터 처리" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="저장·정제·집계" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
       <RadioButton x:Name="HomeLoadChoice" GroupName="HomeSuite" Tag="load" Checked="HomeSuite_Checked" Style="{StaticResource QuestionChoice}" local:UsageHelp.Key="load"><StackPanel><TextBlock Text="부하·응답" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="속도와 처리 지연" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
       <RadioButton x:Name="HomeRecoveryChoice" GroupName="HomeSuite" Tag="recovery" Checked="HomeSuite_Checked" Style="{StaticResource QuestionChoice}" local:UsageHelp.Key="recovery"><StackPanel><TextBlock Text="중단 후 복구" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="재시작·회복 시간" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
      </UniformGrid>
      <TextBlock x:Name="HomeErrorText" Visibility="Collapsed" Foreground="{StaticResource FailBrush}" TextWrapping="Wrap" Margin="32,12,32,0" AutomationProperties.LiveSetting="Assertive"/>
      <Expander x:Name="HomeTargetSettings" Header="시험 대상과 시작 안내" Margin="32,16,32,0"><Border x:Name="StartGuidePanel" Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel>
       <TextBlock Text="시험 대상" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <WrapPanel><RadioButton x:Name="HomeDemoTarget" GroupName="HomeTarget" Content="기본 예제 사용" IsChecked="True" Checked="HomeTarget_Checked" Style="{StaticResource TargetChoice}" Margin="0,0,20,0"/><RadioButton x:Name="HomeApiTarget" GroupName="HomeTarget" Content="내 판정 API 연결" Checked="HomeTarget_Checked" Style="{StaticResource TargetChoice}"/></WrapPanel>
       <TextBlock x:Name="HomeTargetHint" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
       <StackPanel x:Name="HomeApiFields" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="판정 API 주소" Style="{StaticResource SectionLabel}"/><ui:TextBox x:Name="HomeApiBox" PlaceholderText="http://localhost:8000" local:UsageHelp.Key="api"/><TextBlock Text="예: http://localhost:8000 · API가 실행 중인지 확인해 주세요." Style="{StaticResource HintText}" Margin="0,6,0,0"/></StackPanel>
       <TextBlock x:Name="HomeRecommendationText" Style="{StaticResource HintText}" Margin="0,16,0,0"/>
       <TextBlock Text="시험 종류 선택 → 실행 조건 확인 → 시험 시작 → 결과 비교" Style="{StaticResource HintText}" Margin="0,14,0,0"/>
       <TextBlock Text="기본 예제는 서버 연결 없이 사용할 수 있어요. AI 생성과 다른 PC 공유는 준비 중이에요." Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      </StackPanel></Border></Expander>
      <Expander Header="이전 실행 기록" IsExpanded="True" Margin="32,16,32,0"><StackPanel Margin="0,16,0,0"><TextBlock x:Name="OverviewContextText" Style="{StaticResource HintText}" Margin="0,0,0,12"/><DataGrid x:Name="RecentRunsGrid" Height="190" SelectionChanged="RecentRun_Selected"><DataGrid.Columns><DataGridTextColumn Header="실행 번호" Binding="{Binding RunId}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="시험" Binding="{Binding SuiteName}" Width="140"/><DataGridTextColumn Header="통과 / 전체" Binding="{Binding CountText}" Width="110" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/><DataGridTextColumn Header="시험 대상" Binding="{Binding TargetText}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock x:Name="HistoryEmptyText" Text="아직 실행한 시험이 없어요. 위에서 하나 골라 시작해 보세요." Style="{StaticResource HintText}" Margin="0,12,0,0"/><ui:Button Content="실행 기록 더 보기 →" Click="OpenHistory_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,8,0,0"/></StackPanel></Expander>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="ExecutionPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><UniformGrid x:Name="SuitePanel" Columns="4" Margin="26,12">
      <RadioButton x:Name="VerdictSuiteRadio" GroupName="Suite" IsChecked="True" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="verdict"><StackPanel><TextBlock Text="문자 판정"/><TextBlock Text="예상한 정답과 비교" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="PipelineSuiteRadio" GroupName="Suite" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="pipeline"><StackPanel><TextBlock Text="데이터 처리"/><TextBlock Text="중복·순서·지연 확인" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="LoadSuiteRadio" GroupName="Suite" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="load"><StackPanel><TextBlock Text="부하와 응답 속도"/><TextBlock Text="느린 응답·적체 확인" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="RecoverySuiteRadio" GroupName="Suite" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="recovery"><StackPanel><TextBlock Text="중단 후 회복"/><TextBlock Text="재가동 후 집계 확인" Style="{StaticResource HintText}" Margin="0,4,0,0"/></StackPanel></RadioButton>
     </UniformGrid></Border>
     <ScrollViewer x:Name="ExecutionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,28,32,32">
      <TextBlock x:Name="SuiteTitleText" Text="문자 판정 시험" Style="{StaticResource Title}"/>
      <TextBlock x:Name="SuiteDescriptionText" Style="{StaticResource PageSubtitle}" Margin="0,8,0,24"/>
      <Border x:Name="ExecutionOptions" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="실행 조건" FontWeight="SemiBold" FontSize="16"/>
       <StackPanel x:Name="CasesPathField" Margin="0,8,0,0"><TextBlock x:Name="CasesPathLabel" Text="시험 문자와 예상 정답" Style="{StaticResource SectionLabel}"/><ui:TextBox x:Name="CasesPathBox" TextChanged="EnvironmentField_Changed" local:UsageHelp.Key="case-path"/></StackPanel>
       <TextBlock x:Name="ApiUrlHint" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
       <StackPanel x:Name="ExecutionApiField" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="판정 API 주소" Style="{StaticResource SectionLabel}"/><ui:TextBox x:Name="ApiUrlBox" PlaceholderText="http://localhost:8000" TextChanged="EnvironmentField_Changed" local:UsageHelp.Key="api"/></StackPanel>
       <StackPanel x:Name="MeasurementPanel" Visibility="Collapsed"><UniformGrid Columns="3" Margin="0,16,0,0"><StackPanel Margin="0,0,16,0"><TextBlock Text="실행 시간 (초)" Style="{StaticResource HintText}"/><ui:TextBox x:Name="DurationBox" Margin="0,8,0,0" local:UsageHelp.Key="duration"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="초당 전송 건수" Style="{StaticResource HintText}"/><ui:TextBox x:Name="RateBox" Margin="0,8,0,0" local:UsageHelp.Key="rate"/></StackPanel><StackPanel x:Name="StopSecondsField"><TextBlock Text="중단 시간 (초)" Style="{StaticResource HintText}"/><ui:TextBox x:Name="StopSecondsBox" Margin="0,8,0,0" local:UsageHelp.Key="stop"/></StackPanel></UniformGrid><TextBlock x:Name="MeasurementHint" Style="{StaticResource HintText}" Margin="0,12,0,0"/></StackPanel>
       <Expander Header="보고서 저장 위치" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><ui:TextBox x:Name="ReportDirectoryBox" Text="reports" local:UsageHelp.Key="report-path"/><TextBlock Text="기본 위치는 qa/reports예요. 바꾸지 않아도 괜찮아요." Style="{StaticResource HintText}" Margin="0,8,0,0"/></StackPanel></Expander>
      </StackPanel></Border>
      <WrapPanel Margin="0,16,0,24"><ui:Button x:Name="RunButton" Content="시험 시작하기" Style="{StaticResource PrimaryButton}" Click="RunButton_Click" local:UsageHelp.Key="run"/><TextBlock x:Name="RunInfoText" Text="조건을 확인했다면 시험을 시작해 주세요." Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="650"/></WrapPanel>
      <ProgressBar x:Name="RunProgress" Visibility="Collapsed" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
      <Border x:Name="ExecutionError" Visibility="Collapsed" Background="{StaticResource FailBackgroundBrush}" Padding="16,12" CornerRadius="8" Margin="0,0,0,16"><TextBlock x:Name="ExecutionErrorText" Foreground="{StaticResource FailBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
      <StackPanel x:Name="ResultsSection" Visibility="Collapsed">
       <TextBlock x:Name="ResultSummaryTitle" Style="{StaticResource Title}" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="ResultSummaryHint" Style="{StaticResource PageSubtitle}" Margin="0,8,0,16"/>
       <Border x:Name="FakeTargetNotice" Visibility="Collapsed" Background="{StaticResource NoticeBackgroundBrush}" Padding="16,12" CornerRadius="8" Margin="0,0,0,16"><TextBlock Text="연습용 대상의 결과예요. 일부러 틀리는 규칙이 들어 있어서 실제 서비스의 품질과는 다를 수 있어요." Foreground="{StaticResource NoticeBrush}" TextWrapping="Wrap"/></Border>
       <Border Background="{StaticResource AccentBackgroundBrush}" CornerRadius="8" Margin="0,0,0,24"><UniformGrid Columns="4"><Border Style="{StaticResource SummaryTile}"><StackPanel><TextBlock Text="확인한 항목" Style="{StaticResource HintText}"/><TextBlock x:Name="TotalCountText" Text="—" Style="{StaticResource TileValue}"/></StackPanel></Border><Border Style="{StaticResource SummaryTile}"><StackPanel><TextBlock Text="통과" Style="{StaticResource HintText}"/><TextBlock x:Name="PassedCountText" Text="—" Style="{StaticResource TileValue}" Foreground="{StaticResource PassBrush}"/></StackPanel></Border><Border Style="{StaticResource SummaryTile}"><StackPanel><TextBlock Text="다시 볼 항목" Style="{StaticResource HintText}"/><TextBlock x:Name="FailedCountText" Text="—" Style="{StaticResource TileValue}" Foreground="{StaticResource FailBrush}"/></StackPanel></Border><Border Style="{StaticResource SummaryTile}"><StackPanel><TextBlock Text="통과율" Style="{StaticResource HintText}"/><TextBlock x:Name="PassRateText" Text="—" Style="{StaticResource TileValue}"/></StackPanel></Border></UniformGrid></Border>
       <!-- 결과 목록과 상세 칸은 같은 줄 높이(320)를 나눠 써서 위아래 선을 맞춘다. -->
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="320"/></Grid.RowDefinitions>
        <TextBlock Text="항목별 결과" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Grid.Column="2" Text="선택한 항목" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" SelectionChanged="Result_Selected"><DataGrid.Columns><DataGridTextColumn Header="사례" Binding="{Binding CaseId}" Width="120" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="확인 항목" Binding="{Binding CheckName}" Width="160" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="예상 → 실제" Binding="{Binding ComparisonText}" Width="*" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTemplateColumn Header="결과" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ResultBadge" Background="{StaticResource PassBackgroundBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left"><TextBlock x:Name="ResultBadgeText" Text="{Binding ResultLabel}" Foreground="{StaticResource PassBrush}" FontSize="12" FontWeight="SemiBold"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource FailBackgroundBrush}"/><Setter TargetName="ResultBadgeText" Property="Foreground" Value="{StaticResource FailBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock x:Name="DetailCaseText" Text="왼쪽에서 항목을 골라 주세요." Style="{StaticResource HintText}"/><TextBlock Text="예상 정답·기준" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="DetailExpectedText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="실제 결과" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="DetailActualText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="입력 내용" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="DetailInputText" Text="—" TextWrapping="Wrap" LineHeight="22"/><Border Background="{StaticResource AccentBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,16,0,0"><TextBlock x:Name="DetailExplanationText" TextWrapping="Wrap" LineHeight="20" FontSize="13"/></Border></StackPanel></ScrollViewer></Border>
       </Grid>
       <WrapPanel Margin="0,24,0,0"><ui:Button x:Name="OpenReportButton" Content="자세한 보고서 보기 ↗" IsEnabled="False" Click="OpenReportButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="open-report" Margin="0,0,12,8"/><ui:Button x:Name="OpenDashboardButton" Content="전체 기록과 추이 보기 ↗" IsEnabled="False" Click="OpenDashboardButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="dashboard" Margin="0,0,12,8"/><ui:Button Content="같은 조건으로 다시 실행" IsEnabled="{Binding IsEnabled, ElementName=RunButton}" Click="RunButton_Click" Style="{StaticResource TextButton}" local:UsageHelp.Key="run" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </Grid>
    <local:CollaborationView x:Name="CollaborationPage" Visibility="Collapsed"/>
    <Grid x:Name="ReportsPage" Visibility="Collapsed" Margin="32,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Style="{StaticResource PageHeader}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><ui:Button Content="새로고침" Click="RefreshHistory_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><ui:Button Content="전체 추이 보기 ↗" Click="OpenDashboardButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="dashboard"/></StackPanel><StackPanel><TextBlock Text="내 실행 기록" Style="{StaticResource PageTitle}"/><TextBlock Text="기록을 고르면 그때의 조건과 비교 결과를 다시 볼 수 있어요." Style="{StaticResource PageSubtitle}"/></StackPanel></DockPanel>
     <Border Grid.Row="1" Background="{StaticResource AccentBackgroundBrush}" Padding="16,12" CornerRadius="8" Margin="0,0,0,16"><TextBlock Text="이 PC에 저장한 기록만 보여드려요. 연습용 대상인지, 정답 검토가 끝난 사례인지 함께 확인해 주세요." Style="{StaticResource HintText}"/></Border>
     <DataGrid x:Name="HistoryGrid" Grid.Row="2" VerticalAlignment="Top" SelectionChanged="RecentRun_Selected"><DataGrid.Columns><DataGridTextColumn Header="실행 번호" Binding="{Binding RunId}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="시험" Binding="{Binding SuiteName}" Width="140"/><DataGridTextColumn Header="시작한 시간" Binding="{Binding StartedAtText}" Width="150" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/><DataGridTextColumn Header="통과 / 전체" Binding="{Binding CountText}" Width="110" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/><DataGridTextColumn Header="시험 대상" Binding="{Binding TargetText}" Width="120"/><DataGridTextColumn Header="정답 상태" Binding="{Binding LabelText}" Width="130"/></DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" Text="아직 저장한 실행 기록이 없어요. 시험을 한 번 실행하면 여기에 쌓여요." IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=HistoryGrid}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left"><StackPanel Style="{StaticResource PageHeader}"><TextBlock Text="설정" Style="{StaticResource PageTitle}"/><TextBlock Text="변경한 값은 지금 켜 둔 앱에서만 사용해요. 다시 실행하면 기본값으로 돌아가요." Style="{StaticResource PageSubtitle}"/></StackPanel>
     <Border x:Name="SettingsFields" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="시험에 사용할 파일과 주소" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="선택한 문자 사례" Style="{StaticResource SectionLabel}"/><DockPanel><ui:Button x:Name="CasesSelectorButton" DockPanel.Dock="Right" Content="다른 파일 고르기" Click="ChooseCases_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="cases"/><TextBlock x:Name="HeaderCasesText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/></DockPanel><TextBlock Text="판정 API 주소" Style="{StaticResource SectionLabel}"/><ui:TextBox Text="{Binding Text, ElementName=ApiUrlBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="예: http://localhost:8000 (비워 두면 연습용 판정기)" local:UsageHelp.Key="api"/><TextBlock x:Name="HeaderTargetText" Style="{StaticResource HintText}" Margin="0,8,0,0"/><TextBlock Text="보고서 저장 폴더" Style="{StaticResource SectionLabel}"/><ui:TextBox Text="{Binding Text, ElementName=ReportDirectoryBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:UsageHelp.Key="report-path"/><WrapPanel Margin="0,24,0,0"><ui:Button Content="시험 조건으로 돌아가기 →" Click="NewRun_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><ui:Button Content="작업 폴더 열기 ↗" Click="OpenWorkspace_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="workspace"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="AI·팀 공유 연결 상태" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Runpod은 아직 연결하지 않았어요. 지금은 미리 만든 예제 문자로 시험할 수 있어요." Style="{StaticResource HintText}" Margin="0,12,0,0"/><TextBlock Text="공유 기록은 이 앱 안이나 같은 PC의 공유 서버에서 볼 수 있어요. 다른 PC와 EC2 연결은 준비 중이에요." Style="{StaticResource HintText}" Margin="0,8,0,0"/><ui:Button Content="공유 기록과 연결 설정 보기 →" Click="OpenCollaboration_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid></Grid>
  </Grid></Grid>
  <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0"><DockPanel><TextBlock x:Name="ZoomStatusText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,16,0" local:UsageHelp.Key="zoom"/><TextBlock x:Name="StatusText" Text="시험 종류를 선택해 주세요." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel></Border>
  <ResizeGrip Grid.Row="2" Style="{StaticResource WindowResizeGrip}"/>
 </Grid>
</Window>
