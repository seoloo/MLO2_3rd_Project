<Window x:Class="QaRunner.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:QaRunner.Desktop" Title="정보지킴 QA" Width="1120" Height="740" MinWidth="840" MinHeight="500"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
 Foreground="{StaticResource InkBrush}" Background="{StaticResource AppBackgroundBrush}" UseLayoutRounding="True" Style="{StaticResource DesktopWindow}">
 <Window.Resources>
  <!-- 요약 숫자 카드의 큰 숫자 -->
  <Style x:Key="TileValue" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <!-- 연결 상태 줄의 작은 점 -->
  <Style x:Key="StateDot" TargetType="Ellipse"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{StaticResource MutedBrush}"/></Style>
  <Style x:Key="FirstSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <!-- 숨김이 아닌 알림만 보이게 한다 -->
  <Style x:Key="NoticeBar" TargetType="{x:Type ui:InfoBar}" BasedOn="{StaticResource {x:Type ui:InfoBar}}"><Setter Property="IsClosable" Value="False"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Visibility" Value="{Binding IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"/></Style>
  <!-- 홈 시험 카드 안의 아이콘 칸 -->
  <Style x:Key="SuiteIconBox" TargetType="Border"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="14"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <!-- 여정 지도의 한 칸: 선 · 번호 원 · 이름. 끝난 단계는 체크, 지금 단계는 옅은 테두리로 강조 -->
  <DataTemplate x:Key="JourneyStepTemplate">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="LeftLine" Height="6" Background="{StaticResource HoverBrush}" VerticalAlignment="Center"/>
    <Border x:Name="RightLine" Grid.Column="1" Height="6" Background="{StaticResource HoverBrush}" VerticalAlignment="Center"/>
    <Ellipse x:Name="Halo" Grid.ColumnSpan="2" Width="50" Height="50" Fill="{StaticResource AccentBackgroundBrush}" HorizontalAlignment="Center" Visibility="Collapsed"/>
    <Border x:Name="Dot" Grid.ColumnSpan="2" Width="36" Height="36" CornerRadius="18" Background="{StaticResource HoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid><TextBlock x:Name="Num" Text="{Binding Number}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:SymbolIcon x:Name="Check" Symbol="Checkmark24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
    </Border>
    <TextBlock x:Name="Label" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ShortTitle}" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="LeftLine" Property="Visibility" Value="Hidden"/></DataTrigger>
    <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="RightLine" Property="Visibility" Value="Hidden"/></DataTrigger>
    <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Num" Property="Visibility" Value="Collapsed"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding LeftActive}" Value="True"><Setter TargetName="LeftLine" Property="Background" Value="{StaticResource AccentBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding RightActive}" Value="True"><Setter TargetName="RightLine" Property="Background" Value="{StaticResource AccentBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Halo" Property="Visibility" Value="Visible"/><Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Num" Property="Foreground" Value="White"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}"/><Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Grid Background="{StaticResource AppBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <local:WindowTitleBar x:Name="TitleBar"/>
  <Grid x:Name="WorkspaceViewport" Grid.Row="1" ClipToBounds="True"><Grid x:Name="WorkspaceRoot">
   <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- 왼쪽 메뉴: 홈 · 시험 · 기록 · 관리 -->
   <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="20,16,12,16">
     <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><ui:SymbolIcon Symbol="Shield24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="정보지킴 QA" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="자동화 점검 도구" Style="{StaticResource HintText}" FontSize="11"/></StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
     <ui:Button Command="{x:Static ApplicationCommands.Help}" Appearance="Transparent" BorderThickness="0" Margin="8,0" Height="40" Padding="16,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource MutedBrush}" local:UsageHelp.Key="help"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="QuestionCircle24" FontSize="18"/><TextBlock Text="사용 안내" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ui:Button>
     <DockPanel Margin="20,8,12,0">
      <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentBackgroundBrush}" Margin="0,0,10,0"><TextBlock x:Name="UserInitialText" Text="P" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UserNameText" Text="Playdata" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="이 PC · 연습용" Style="{StaticResource HintText}" FontSize="11"/></StackPanel>
     </DockPanel>
    </StackPanel>
    <StackPanel x:Name="NavigationBar">
     <RadioButton x:Name="HomeNav" GroupName="Section" Content="홈" Tag="home" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" IsChecked="True" local:UsageHelp.Key="home"/>
     <RadioButton x:Name="TestNav" GroupName="Section" Content="시험" Tag="run" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="run-page"/>
     <RadioButton x:Name="HistoryNav" GroupName="Section" Content="기록" Tag="reports" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="reports"/>
     <RadioButton x:Name="ManageNav" GroupName="Section" Content="관리" Tag="cases" Style="{StaticResource SidebarNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="manage"/>
    </StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- 기록·관리의 제목과 안쪽 탭 (홈·시험 화면에서는 숨김) -->
    <StackPanel x:Name="SectionHeader" Margin="32,20,32,0" Visibility="Collapsed">
     <TextBlock x:Name="SectionTitleText" Text="기록" Style="{StaticResource PageTitle}"/>
     <StackPanel x:Name="SubTabBar" Orientation="Horizontal" Margin="-12,8,0,0">
      <RadioButton x:Name="ReportsTab" GroupName="SubPage" Content="내 기록" Tag="reports" Style="{StaticResource SubTabNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="reports"/>
      <RadioButton x:Name="TeamTab" GroupName="SubPage" Content="팀 공유" Tag="team" Style="{StaticResource SubTabNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="team"/>
      <RadioButton x:Name="CasesTab" GroupName="SubPage" Content="시험 문자" Tag="cases" Style="{StaticResource SubTabNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="case-page"/>
      <RadioButton x:Name="AiTab" GroupName="SubPage" Content="AI 문자" Tag="ai" Style="{StaticResource SubTabNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="ai-page"/>
      <RadioButton x:Name="SettingsTab" GroupName="SubPage" Content="설정" Tag="settings" Style="{StaticResource SubTabNavigation}" Checked="Navigation_Checked" local:UsageHelp.Key="settings"/>
     </StackPanel>
    </StackPanel>

    <!-- ===== 홈: 인사 · 여정 지도 · 다음 할 일 · 요약 · 시험 카드 · 최근 실행 ===== -->
    <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="HomeMain" Margin="32,24,32,32">
      <TextBlock x:Name="HomeGreetingText" Text="안녕하세요" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock x:Name="HomeSubtitleText" Text="아래 길을 따라가면 첫 점검을 끝낼 수 있어요." Style="{StaticResource PageSubtitle}" FontSize="14"/>
      <!-- 여정 지도 -->
      <Border Style="{StaticResource SoftCard}" Margin="0,20,0,0" Padding="20,14,20,16" local:UsageHelp.Key="checklist">
       <StackPanel>
        <DockPanel><TextBlock x:Name="JourneyProgressText" DockPanel.Dock="Right" Text="0/4 완료" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="처음 사용하는 순서" FontSize="14" FontWeight="SemiBold"/></DockPanel>
        <ItemsControl x:Name="JourneyItems" ItemTemplate="{StaticResource JourneyStepTemplate}" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
       </StackPanel>
      </Border>
      <!-- 다음 할 일 + 요약 -->
      <Grid Margin="0,20,0,0" Height="176"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
       <!-- Adapted from WPF UI 2.0.3 Demo Dashboard. See THIRD-PARTY-NOTICES.txt. 배경 사진 위에 민트 그라데이션을 덮는다. -->
       <Border x:Name="HomeHero" CornerRadius="22" Effect="{StaticResource CardShadow}">
        <Border.Background><SolidColorBrush Color="#0D9488"/></Border.Background>
        <Grid x:Name="HomeHeroContent">
         <Rectangle RadiusX="22" RadiusY="22"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F00D9488" Offset="0"/><GradientStop Color="#E014B8A6" Offset="0.55"/><GradientStop Color="#C822C55E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
         <Ellipse Width="200" Height="200" Fill="#26FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-40,0"/>
         <Ellipse Width="130" Height="130" Fill="#1FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-60"/>
         <StackPanel Margin="26,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border Background="#33FFFFFF" CornerRadius="11" Padding="10,2" HorizontalAlignment="Left"><TextBlock Text="다음 할 일" FontSize="12" FontWeight="SemiBold" Foreground="White"/></Border>
          <TextBlock x:Name="NextStepTitle" Text="빠른 점검을 골라 볼까요?" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="NextStepHint" Foreground="#E6FFFFFF" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <ui:Button x:Name="NextStepButton" Click="NextStep_Click" Style="{StaticResource PillButton}" Margin="0,14,0,0" HorizontalAlignment="Left" local:UsageHelp.Key="next-step"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="14" Filled="True" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="NextStepButtonText" Text="빠른 점검 고르기" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}"/></StackPanel></ui:Button>
         </StackPanel>
         <TextBlock Text="WPF UI Gallery" Foreground="#99FFFFFF" FontSize="11" Margin="14,8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource SoftCard}" CornerRadius="22">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid Width="104" Height="104" VerticalAlignment="Center">
          <Ellipse Stroke="{StaticResource AccentBackgroundBrush}" StrokeThickness="11"/>
          <Path x:Name="HomeRateArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="HomeRateText" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="통과율" Style="{StaticResource HintText}" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
         </Grid>
         <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="이번 주 실행" Style="{StaticResource HintText}"/><TextBlock x:Name="HomeWeekText" Text="0회" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="다시 볼 항목" Style="{StaticResource HintText}" Margin="0,12,0,0"/><TextBlock x:Name="HomeRecheckText" Text="0건" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FailBrush}"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
      <!-- 시험 영역과 종류 카드: 영역 탭으로 서비스 · 앱 · QA 도구를 바꾸고, 카드를 누르면 오른쪽 조건 시트 -->
      <DockPanel Margin="0,28,0,2">
       <TextBlock x:Name="HomeAreaHint" DockPanel.Dock="Right" Text="카드를 누르면 오른쪽에서 조건을 확인해요" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
       <TextBlock Text="무엇을 점검할까요" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <StackPanel x:Name="HomeAreaTabs" Orientation="Horizontal" local:UsageHelp.Key="home-area">
        <RadioButton x:Name="ServiceAreaTab" GroupName="HomeArea" Tag="service" Content="서비스" IsChecked="True" Checked="HomeArea_Checked" Style="{StaticResource SubTabNavigation}"/>
        <RadioButton x:Name="AppAreaTab" GroupName="HomeArea" Tag="app" Content="앱" Checked="HomeArea_Checked" Style="{StaticResource SubTabNavigation}"/>
        <RadioButton x:Name="QaToolAreaTab" GroupName="HomeArea" Tag="qatool" Content="QA 도구" Checked="HomeArea_Checked" Style="{StaticResource SubTabNavigation}"/>
       </StackPanel>
      </DockPanel>
      <TextBlock x:Name="HomeAreaDescription" Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
      <UniformGrid x:Name="HomeSuiteCards" Columns="4" Margin="-6">
       <Button x:Name="HomeVerdictCard" Tag="verdict" Click="SuiteCard_Click" Style="{StaticResource SuiteCard}" local:UsageHelp.Key="preset-quick"><StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" Background="{StaticResource AccentBackgroundBrush}" VerticalAlignment="Top" CornerRadius="10"><TextBlock Text="추천" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></Border><Border Style="{StaticResource SuiteIconBox}" Background="{StaticResource AccentBackgroundBrush}"><ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DockPanel>
        <TextBlock Text="빠른 점검" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="문자 판정 · 약 10초" Style="{StaticResource HintText}"/>
        <TextBlock x:Name="PresetVerdictLast" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
       </StackPanel></Button>
       <Button x:Name="HomePipelineCard" Tag="pipeline" Click="SuiteCard_Click" Style="{StaticResource SuiteCard}" local:UsageHelp.Key="pipeline"><StackPanel>
        <Border Style="{StaticResource SuiteIconBox}" Background="#EEF2FF"><ui:SymbolIcon Symbol="DataTrending24" FontSize="20" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="데이터 처리" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="중복·순서·지연 · 약 20초" Style="{StaticResource HintText}"/>
        <TextBlock x:Name="PresetPipelineLast" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
       </StackPanel></Button>
       <Button x:Name="HomeLoadCard" Tag="load" Click="SuiteCard_Click" Style="{StaticResource SuiteCard}" local:UsageHelp.Key="load"><StackPanel>
        <Border Style="{StaticResource SuiteIconBox}" Background="#E0F2FE"><ui:SymbolIcon Symbol="Gauge24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="부하·응답" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="초당 5건 · 약 30초" Style="{StaticResource HintText}"/>
        <TextBlock x:Name="PresetLoadLast" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
       </StackPanel></Button>
       <Button x:Name="HomeRecoveryCard" Tag="recovery" Click="SuiteCard_Click" Style="{StaticResource SuiteCard}" local:UsageHelp.Key="recovery"><StackPanel>
        <Border Style="{StaticResource SuiteIconBox}" Background="#FCE7F3"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20" Foreground="#DB2777" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="중단 후 복구" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="15초 멈춤 · 약 1분" Style="{StaticResource HintText}"/>
        <TextBlock x:Name="PresetRecoveryLast" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
       </StackPanel></Button>
      </UniformGrid>
      <!-- 앱 영역: 가짜 판정 서버를 켜 두고 앱을 붙인다. 왼쪽은 서버 조건과 앱에서 확인할 것, 오른쪽은 받은 요청 목록 -->
      <Grid x:Name="HomeAppArea" Margin="-6" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource SoftCard}" Margin="6" Padding="20,16">
        <StackPanel>
         <DockPanel>
          <Border x:Name="MockStateBadge" DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" CornerRadius="10" VerticalAlignment="Top"><TextBlock x:Name="MockStateText" Text="꺼져 있어요" FontSize="11" FontWeight="SemiBold"/></Border>
          <Border Style="{StaticResource SuiteIconBox}" Background="#FEF3C7"><ui:SymbolIcon Symbol="Phone24" FontSize="20" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="가짜 판정 서버" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PresetMockApiLast" Style="{StaticResource HintText}" FontWeight="SemiBold"/></StackPanel>
         </DockPanel>
         <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0" Text="판정 API 대신 정해 둔 응답을 돌려줘요. 앱의 API 주소를 이 서버로 바꾸면 B의 서버 없이도 정상 판정과 오류·지연 화면을 확인할 수 있어요."/>
         <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="포트" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="MockPortBox" Text="8000" local:UsageHelp.Key="mock-port"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="응답 방식" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ComboBox x:Name="MockScenarioBox" DisplayMemberPath="Label" SelectionChanged="MockScenario_Changed" local:UsageHelp.Key="mock-scenario"/></StackPanel>
         </Grid>
         <CheckBox x:Name="MockAllowLanBox" Content="같은 Wi-Fi의 휴대폰에서도 접속 허용" Margin="0,10,0,0" local:UsageHelp.Key="mock-lan"/>
         <Border Background="{StaticResource AccentBackgroundBrush}" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
          <StackPanel><TextBlock Text="앱에서 확인할 것" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="MockExpectationText" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"/><TextBlock x:Name="MockResponseText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
         </Border>
         <StackPanel x:Name="MockAddressPanel" Visibility="Collapsed" Margin="0,12,0,0">
          <DockPanel><ui:Button DockPanel.Dock="Right" Content="주소 복사" Click="CopyMockAddress_Click" Style="{StaticResource TextButton}" MinHeight="24" Padding="8,2"/><TextBlock Text="앱에 넣을 주소" Style="{StaticResource SectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <TextBox x:Name="MockAddressText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="13" Padding="0,2"/>
         </StackPanel>
         <ui:InfoBar x:Name="MockError" Severity="Error" IsClosable="True" Margin="0,10,0,0"/>
         <UniformGrid Columns="2" Margin="0,14,0,0">
          <ui:Button x:Name="MockStartButton" Content="서버 켜기" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource PrimaryButton}" Click="MockStart_Click" HorizontalAlignment="Stretch" MinHeight="40" Margin="0,0,6,0" local:UsageHelp.Key="mock-server"/>
          <ui:Button x:Name="MockStopButton" Content="끄고 결과 보기" Icon="{ui:SymbolIcon Stop24}" Style="{StaticResource SecondaryButton}" Click="MockStop_Click" HorizontalAlignment="Stretch" MinHeight="40" Margin="6,0,0,0" IsEnabled="False"/>
         </UniformGrid>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource SoftCard}" Margin="6" Padding="0,16,0,12">
        <DockPanel>
         <DockPanel DockPanel.Dock="Top" Margin="20,0,20,6"><TextBlock x:Name="MockRequestCountText" DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center"/><TextBlock Text="받은 요청" FontSize="15" FontWeight="SemiBold"/></DockPanel>
         <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="20,8,20,0" Text="문자 끝에 #500, #slow, #timeout처럼 표시를 붙이면 그 요청만 다른 응답을 받아요. 표시는 응답 방식 목록 오른쪽에 적혀 있어요."/>
         <Grid MinHeight="220">
          <DataGrid x:Name="MockRequestsGrid" HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="320" SelectionChanged="MockRequest_Selected"><DataGrid.Columns>
           <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="84"/>
           <DataGridTextColumn Header="문자" Binding="{Binding MessageText}" Width="*" ElementStyle="{StaticResource TrimmedCell}"/>
           <DataGridTextColumn Header="돌려준 응답" Binding="{Binding ResponseText}" Width="150" ElementStyle="{StaticResource TrimmedCell}"/>
           <DataGridTemplateColumn Header="요청 형식" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse x:Name="FormatDot" Width="8" Height="8" Fill="{StaticResource FailBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding FormatText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProblemText}"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding MatchesContract}" Value="True"><Setter TargetName="FormatDot" Property="Fill" Value="{StaticResource PassBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns></DataGrid>
          <TextBlock x:Name="MockEmptyText" Style="{StaticResource EmptyListText}" Text="서버를 켜고 앱에서 판정을 요청하면 여기에 바로 보여요."/>
         </Grid>
        </DockPanel>
       </Border>
      </Grid>
      <!-- QA 도구 영역: 이 QA 도구 자체를 점검하는 카드와, CI에서 함께 도는 개발자용 점검 안내 -->
      <Grid x:Name="HomeQaToolCards" Margin="-6" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
       <Button x:Name="HomeSelfCheckCard" Tag="selfcheck" Click="SuiteCard_Click" Style="{StaticResource SuiteCard}" local:UsageHelp.Key="selfcheck"><StackPanel>
        <Border Style="{StaticResource SuiteIconBox}" Background="#DCFCE7"><ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="QA 도구 점검" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="채점·정답 계산·보고서 · 약 1초" Style="{StaticResource HintText}"/>
        <TextBlock x:Name="PresetSelfCheckLast" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
       </StackPanel></Button>
       <Border Grid.Column="1" Style="{StaticResource SoftCard}" Margin="6" Padding="20,16">
        <StackPanel>
         <TextBlock Text="개발자용 점검도 함께 돌아요" FontSize="15" FontWeight="SemiBold"/>
         <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,8" Text="QA 도구 점검은 답을 이미 아는 입력 11가지로 채점기가 틀린 결과를 잡아내는지 봐요. 코드를 고칠 때는 아래 점검도 함께 통과해야 해요."/>
         <TextBlock Text="• dotnet test — QA 러너 단위 시험" FontSize="13"/>
         <TextBlock Text="• --ui-smoke — 이 앱의 화면을 실제로 눌러 보는 점검" FontSize="13" Margin="0,2,0,0"/>
         <TextBlock Text="• GitHub Actions — 푸시할 때마다 위 점검과 QA 도구 점검을 자동 실행" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>
       </Border>
      </Grid>
      <!-- 최근 실행 -->
      <Border Style="{StaticResource SoftCard}" Margin="0,22,0,0" Padding="0,14,0,8">
       <StackPanel>
        <DockPanel Margin="20,0,12,4"><ui:Button DockPanel.Dock="Right" Content="전체 보기" Click="OpenHistory_Click" Style="{StaticResource TextButton}" MinHeight="26" Padding="8,2"/><TextBlock Text="최근 실행" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <DataGrid x:Name="RecentRunsGrid" HeadersVisibility="None" GridLinesVisibility="None" SelectionChanged="RecentRun_Selected"><DataGrid.Columns>
         <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse x:Name="RunDot" Width="10" Height="10" Fill="{StaticResource NoticeBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="{Binding SuiteName}" FontWeight="SemiBold"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding IsAllPassed}" Value="True"><Setter TargetName="RunDot" Property="Fill" Value="{StaticResource PassBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Binding="{Binding StartedAtText}" Width="140" ElementStyle="{StaticResource NumberCell}"/>
         <DataGridTextColumn Binding="{Binding CountText}" Width="90" ElementStyle="{StaticResource NumberCell}"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock x:Name="HistoryEmptyText" Text="아직 실행한 시험이 없어요. 위의 ‘빠른 점검’부터 시작해 보세요." Style="{StaticResource HintText}" FontSize="13" Margin="20,8,20,8"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <!-- ===== 시험: 진행 상태와 결과 ===== -->
    <ScrollViewer x:Name="ExecutionScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="ExecutionPage" Margin="32,24,32,32">
      <StackPanel x:Name="TestMain">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
         <ui:Button Click="OpenSheet_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" local:UsageHelp.Key="change-conditions"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Options24" FontSize="15"/><TextBlock Text="조건 바꾸기" Margin="8,0,0,0"/></StackPanel></ui:Button>
         <ui:Button x:Name="OpenDashboardButton" Content="전체 추이" IsEnabled="False" Click="OpenDashboardButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="dashboard" Margin="0,0,8,0"/>
         <ui:Button x:Name="OpenReportButton" Content="보고서 열기" IsEnabled="False" Click="OpenReportButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="open-report"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,0"><TextBlock Text="시험 결과" Style="{StaticResource PageTitle}"/><TextBlock x:Name="RunInfoText" Text="홈에서 시험 카드를 고르거나 ‘조건 바꾸기’를 눌러 주세요." Style="{StaticResource PageSubtitle}"/></StackPanel>
       </DockPanel>
       <ProgressBar x:Name="RunProgress" Visibility="Collapsed" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0"/>
       <ui:InfoBar x:Name="ExecutionError" Style="{StaticResource NoticeBar}" Severity="Error" IsOpen="False" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive"/>
       <!-- 시험 중: 무엇을 하고 있는지, 얼마나 지났고 얼마나 남았는지, 지금 단계를 보여 준다 -->
       <Border x:Name="RunningCard" Style="{StaticResource SoftCard}" MinHeight="320" Margin="0,20,0,0" Padding="40,32" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" AutomationProperties.LiveSetting="Polite">
         <Grid Width="72" Height="72" HorizontalAlignment="Center">
          <Ellipse Fill="{StaticResource AccentBackgroundBrush}"/>
          <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
         <TextBlock x:Name="RunningTitleText" Text="시험을 진행하고 있어요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
         <TextBlock x:Name="RunningHintText" Style="{StaticResource HintText}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
         <ProgressBar x:Name="RunningProgressBar" Height="8" Maximum="100" Margin="0,22,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentBackgroundBrush}" BorderThickness="0"/>
         <DockPanel Margin="0,8,0,0">
          <TextBlock x:Name="RunningRemainingText" DockPanel.Dock="Right" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
          <TextBlock x:Name="RunningElapsedText" Text="0초 지남" Style="{StaticResource HintText}"/>
         </DockPanel>
         <!-- 단계: 입력 보내기 → 결과 모으기 → 보고서 저장. 지금 단계만 청록으로 칠한다 -->
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Border x:Name="RunStepSend" CornerRadius="14" Padding="12,4"><TextBlock x:Name="RunStepSendText" Text="① 입력 보내기" FontSize="12"/></Border>
          <TextBlock Text="›" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
          <Border x:Name="RunStepCollect" CornerRadius="14" Padding="12,4"><TextBlock x:Name="RunStepCollectText" Text="② 결과 모으기" FontSize="12"/></Border>
          <TextBlock Text="›" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
          <Border x:Name="RunStepReport" CornerRadius="14" Padding="12,4"><TextBlock x:Name="RunStepReportText" Text="③ 채점·보고서 저장" FontSize="12"/></Border>
         </StackPanel>
         <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="시험이 끝날 때까지 다른 메뉴로는 이동할 수 없어요."/>
        </StackPanel>
       </Border>
       <!-- 결과가 없을 때 (시험 중에는 위의 진행 카드를 대신 보여 준다) -->
       <Border MinHeight="320" Margin="0,20,0,0" Padding="32">
        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SoftCard}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ResultsSection}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Visibility, ElementName=RunningCard}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
         <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentBackgroundBrush}" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock Text="아직 결과가 없어요" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
         <TextBlock Text="시험을 고르면 오른쪽에서 조건을 확인하고 바로 시작할 수 있어요." Style="{StaticResource HintText}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
         <ui:Button Content="시험 고르기" Click="OpenSheet_Click" Style="{StaticResource PrimaryButton}" CornerRadius="20" MinHeight="40" Padding="22,6" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
       </Border>
       <StackPanel x:Name="ResultsSection" Visibility="Collapsed" Margin="0,20,0,0">
        <!-- 완료 카드: 시험이 끝났다는 것과 요약·다음 행동을 결과 맨 위에 홈 배너와 같은 모양으로 보여 준다 -->
        <Border x:Name="ResultHero" CornerRadius="20" Effect="{StaticResource CardShadow}" Padding="24,20">
         <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0D9488" Offset="0"/><GradientStop Color="#10B981" Offset="1"/></LinearGradientBrush></Border.Background>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="28" Background="White" VerticalAlignment="Center"><ui:SymbolIcon x:Name="ResultHeroIcon" Symbol="Checkmark24" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
           <WrapPanel>
            <TextBlock x:Name="ResultHeroTitle" Text="시험이 끝났어요" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <Border x:Name="ResultTargetChip" Background="White" CornerRadius="11" Padding="10,2" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="ResultTargetChipText" Text="연습용 대상" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NoticeBrush}"/></Border>
           </WrapPanel>
           <TextBlock x:Name="ResultSummaryTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
           <TextBlock x:Name="ResultSummaryHint" Foreground="#E6FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
           <ui:Button x:Name="HeroReportButton" Content="보고서 열기" Click="OpenReportButton_Click" Style="{StaticResource PillButton}" IsEnabled="{Binding IsEnabled, ElementName=OpenReportButton}" Margin="0,0,8,0" local:UsageHelp.Key="open-report"/>
           <ui:Button Content="다시 실행" Click="RerunDisplayed_Click" Style="{StaticResource PillButton}" IsEnabled="{Binding IsEnabled, ElementName=RunButton}" local:UsageHelp.Key="run"/>
          </StackPanel>
         </Grid>
        </Border>
        <ui:InfoBar x:Name="FakeTargetNotice" Style="{StaticResource NoticeBar}" Severity="Warning" IsOpen="False" Margin="0,12,0,0"/>
        <Border Height="12"/>
        <UniformGrid Columns="4" Margin="-6">
         <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="확인한 항목" Style="{StaticResource HintText}"/><TextBlock x:Name="TotalCountText" Text="—" Style="{StaticResource TileValue}"/></StackPanel></Border>
         <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="통과" Style="{StaticResource HintText}"/><TextBlock x:Name="PassedCountText" Text="—" Style="{StaticResource TileValue}" Foreground="{StaticResource PassBrush}"/></StackPanel></Border>
         <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="다시 볼 항목" Style="{StaticResource HintText}"/><TextBlock x:Name="FailedCountText" Text="—" Style="{StaticResource TileValue}" Foreground="{StaticResource FailBrush}"/></StackPanel></Border>
         <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="통과율" Style="{StaticResource HintText}"/><TextBlock x:Name="PassRateText" Text="—" Style="{StaticResource TileValue}"/><ProgressBar x:Name="PassRateBar" Height="6" Maximum="100" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentBackgroundBrush}" BorderThickness="0"/></StackPanel></Border>
        </UniformGrid>
        <DockPanel Margin="0,24,0,0"><ui:Button DockPanel.Dock="Right" Content="같은 조건으로 다시 실행" IsEnabled="{Binding IsEnabled, ElementName=RunButton}" Click="RerunDisplayed_Click" Style="{StaticResource TextButton}" local:UsageHelp.Key="run" Margin="0,-6,-8,0" MinHeight="28"/><TextBlock Text="항목별 결과" Style="{StaticResource FirstSectionTitle}"/></DockPanel>
        <Grid Panel.ZIndex="1">
        <Border Style="{StaticResource SoftCard}" Padding="0,6" ClipToBounds="True">
         <DataGrid x:Name="ResultsGrid" MaxHeight="300" SelectionChanged="Result_Selected" PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown"><DataGrid.Columns><DataGridTextColumn Header="사례" Binding="{Binding CaseId}" Width="100" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="확인 항목" Binding="{Binding CheckName}" Width="130" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="예상 → 실제" Binding="{Binding ComparisonText}" Width="*" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTemplateColumn Header="결과" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ResultBadge" Background="{StaticResource PassBackgroundBrush}" CornerRadius="10" Padding="8,1" HorizontalAlignment="Left"><TextBlock x:Name="ResultBadgeText" Text="{Binding ResultLabel}" Foreground="{StaticResource PassBrush}" FontSize="12" FontWeight="SemiBold"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource FailBackgroundBrush}"/><Setter TargetName="ResultBadgeText" Property="Foreground" Value="{StaticResource FailBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
        </Border>
        <!-- 다음 행동 말풍선: 처음 몇 번은 첫 번째 줄을 가리키며 무엇을 누를지 알려 준다. 표 아래로 넘쳐도 위에 보이도록 ZIndex를 올렸다 -->
        <StackPanel x:Name="ResultCoach" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,84,0,0" Width="360">
         <Path Data="M0,10 L10,0 L20,10 Z" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" Margin="28,0,0,-1"/>
         <Border Background="{StaticResource InkBrush}" CornerRadius="14" Padding="18,14" Effect="{StaticResource CardShadow}">
          <StackPanel>
           <TextBlock x:Name="ResultCoachTitle" Text="시험이 끝났어요!" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
           <TextBlock x:Name="ResultCoachText" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
           <ui:Button Content="알겠어요" Click="CloseCoach_Click" Style="{StaticResource PrimaryButton}" CornerRadius="14" MinHeight="28" Padding="14,2" HorizontalAlignment="Right"/>
          </StackPanel>
         </Border>
        </StackPanel>
        </Grid>
        <DockPanel Margin="0,24,0,0"><TextBlock x:Name="DetailCaseText" DockPanel.Dock="Right" Text="위에서 항목을 골라 주세요." Style="{StaticResource HintText}" Margin="0,0,0,8"/><TextBlock Text="선택한 항목" Style="{StaticResource FirstSectionTitle}"/></DockPanel>
        <Border Style="{StaticResource SoftCard}"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="예상 정답·기준" Style="{StaticResource HintText}"/><TextBlock x:Name="DetailExpectedText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="실제 결과" Style="{StaticResource HintText}"/><TextBlock x:Name="DetailActualText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
         </Grid>
         <TextBlock Text="입력 내용" Style="{StaticResource HintText}" Margin="0,16,0,4"/>
         <TextBlock x:Name="DetailInputText" Text="—" TextWrapping="Wrap" LineHeight="22"/>
         <Border Background="{StaticResource AccentBackgroundBrush}" Padding="14,10" CornerRadius="14" Margin="0,16,0,0"><TextBlock x:Name="DetailExplanationText" TextWrapping="Wrap" LineHeight="20" FontSize="13" Foreground="{StaticResource CalloutInkBrush}"/></Border>
        </StackPanel></Border>
       </StackPanel>
      </StackPanel>
     </Grid>
    </ScrollViewer>

    <local:CollaborationView x:Name="CollaborationPage" Grid.Row="1" Visibility="Collapsed"/>

    <!-- ===== 기록 › 내 기록 ===== -->
    <Grid x:Name="ReportsPage" Grid.Row="1" Visibility="Collapsed" Margin="32,12,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><ui:Button Content="새로고침" Click="RefreshHistory_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><ui:Button Content="전체 추이" Click="OpenDashboardButton_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="dashboard"/></StackPanel><TextBlock Text="이 PC에 저장한 기록이에요. 하나를 고르면 시험 화면에서 다시 열어요." Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"/></DockPanel>
     <UniformGrid Grid.Row="1" Columns="3" Margin="-6,12,-6,0">
      <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="저장한 기록" Style="{StaticResource HintText}"/><TextBlock x:Name="HistoryCountText" Text="0" Style="{StaticResource TileValue}"/></StackPanel></Border>
      <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="평균 통과율" Style="{StaticResource HintText}"/><TextBlock x:Name="HistoryAverageText" Text="—" Style="{StaticResource TileValue}"/></StackPanel></Border>
      <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="6"><StackPanel><TextBlock Text="마지막 실행" Style="{StaticResource HintText}"/><TextBlock x:Name="HistoryLatestText" Text="—" Style="{StaticResource TileValue}"/></StackPanel></Border>
     </UniformGrid>
     <TextBlock Grid.Row="2" Text="실행 목록" Style="{StaticResource SectionTitle}"/>
     <Border Grid.Row="3" Style="{StaticResource SoftCard}" Padding="0,6" VerticalAlignment="Top"><Grid>
      <DataGrid x:Name="HistoryGrid" SelectionChanged="RecentRun_Selected"><DataGrid.Columns><DataGridTextColumn Header="실행 번호" Binding="{Binding RunId}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}"/><DataGridTextColumn Header="영역" Binding="{Binding AreaName}" Width="84"/><DataGridTextColumn Header="시험" Binding="{Binding SuiteName}" Width="136"/><DataGridTextColumn Header="시작한 시간" Binding="{Binding StartedAtText}" Width="130" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/><DataGridTextColumn Header="통과 / 전체" Binding="{Binding CountText}" Width="100" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/><DataGridTextColumn Header="시험 대상" Binding="{Binding TargetText}" Width="110"/><DataGridTextColumn Header="정답 상태" Binding="{Binding LabelText}" Width="130"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="아직 저장한 실행 기록이 없어요. 홈에서 ‘빠른 점검’을 눌러 보세요." IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=HistoryGrid}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid></Border>
    </Grid>

    <!-- ===== 관리 › 설정 ===== -->
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,12,32,24" MaxWidth="1000" HorizontalAlignment="Stretch">
     <TextBlock Text="시험 대상" Style="{StaticResource FirstSectionTitle}"/>
     <StackPanel x:Name="SettingsFields">
      <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="DocumentText24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="시험 문자 파일" Style="{StaticResource SettingName}"/><TextBlock x:Name="HeaderCasesText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></ui:CardControl.Header><ui:Button x:Name="CasesSelectorButton" Content="파일 고르기" Click="ChooseCases_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="cases"/></ui:CardControl>
      <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="Globe24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="판정 API 주소" Style="{StaticResource SettingName}"/><TextBlock x:Name="HeaderTargetText" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><ui:TextBox Width="300" Text="{Binding Text, ElementName=ApiUrlBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="http://localhost:8000" local:UsageHelp.Key="api"/></ui:CardControl>
     </StackPanel>
     <TextBlock Text="보고서" Style="{StaticResource SectionTitle}"/>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="Folder24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="보고서 저장 폴더" Style="{StaticResource SettingName}"/><TextBlock Text="HTML·JSON 보고서와 실행 기록 (기본 qa/reports)" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><ui:TextBox Width="300" Text="{Binding Text, ElementName=ReportDirectoryBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:UsageHelp.Key="report-path"/></ui:CardControl>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="FolderOpen24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="작업 폴더" Style="{StaticResource SettingName}"/><TextBlock Text="경로의 기준이 되는 qa 폴더" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><ui:Button Content="탐색기에서 열기" Click="OpenWorkspace_Click" Style="{StaticResource SecondaryButton}" local:UsageHelp.Key="workspace"/></ui:CardControl>
     <TextBlock Text="연결 상태" Style="{StaticResource SectionTitle}"/>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="PeopleTeam24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="결과 공유" Style="{StaticResource SettingName}"/><TextBlock Text="이 앱 안 · 같은 PC 공유 서버 (다른 PC·EC2는 준비 중)" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><ui:Button Content="팀 공유 보기" Click="OpenCollaboration_Click" Style="{StaticResource SecondaryButton}"/></ui:CardControl>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="Bot24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="AI 문자 생성 (Runpod)" Style="{StaticResource SettingName}"/><TextBlock Text="모델과 생성 정책을 정하면 연결해요" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource StateDot}"/><TextBlock Text="준비 중" Style="{StaticResource HintText}" FontSize="13"/></StackPanel></ui:CardControl>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="Server24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="Kafka · MongoDB · Spark" Style="{StaticResource SettingName}"/><TextBlock Text="연결 코드는 들어 있어요. 수업에서 구성한 뒤 연결해요" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource StateDot}"/><TextBlock Text="연결 전" Style="{StaticResource HintText}" FontSize="13"/></StackPanel></ui:CardControl>
     <TextBlock Text="처음 사용하는 순서" Style="{StaticResource SectionTitle}"/>
     <ui:CardControl Style="{StaticResource SettingCard}"><ui:CardControl.Icon><ui:SymbolIcon Symbol="TaskListLtr24"/></ui:CardControl.Icon><ui:CardControl.Header><StackPanel><TextBlock Text="안내 다시 보기" Style="{StaticResource SettingName}"/><TextBlock Text="홈의 여정 지도와 ‘다음 할 일’을 처음 상태로 되돌려요" Style="{StaticResource HintText}"/></StackPanel></ui:CardControl.Header><ui:Button Content="처음부터 다시" Click="ResetChecklist_Click" Style="{StaticResource SecondaryButton}"/></ui:CardControl>
    </StackPanel></ScrollViewer>

    <!-- ===== 오른쪽 조건 시트: 시험 카드·조건 바꾸기를 누르면 열린다 ===== -->
    <Grid x:Name="SheetLayer" Grid.RowSpan="2" Visibility="Collapsed">
     <Border x:Name="SheetBackdrop" Background="#330F2A27" MouseLeftButtonDown="SheetBackdrop_MouseDown"/>
     <Border x:Name="ConditionSheet" Width="400" HorizontalAlignment="Right" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
      <Border.Effect><DropShadowEffect Color="#0F2A27" BlurRadius="30" ShadowDepth="0" Opacity="0.15"/></Border.Effect>
      <DockPanel>
       <Border DockPanel.Dock="Bottom" Padding="24,12,24,20" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
         <TextBlock x:Name="SheetDurationText" Text="약 10초 걸려요" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <ui:Button x:Name="RunButton" Content="시험 시작하기" Style="{StaticResource PrimaryButton}" Click="RunButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="24" FontSize="15" local:UsageHelp.Key="run"/>
        </StackPanel>
       </Border>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24,20,24,16">
        <DockPanel>
         <ui:Button x:Name="CloseSheetButton" DockPanel.Dock="Right" Click="CloseSheet_Click" Appearance="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Top" ToolTip="닫기" AutomationProperties.Name="조건 시트 닫기"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/></ui:Button>
         <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBackgroundBrush}" HorizontalAlignment="Left"><ui:SymbolIcon x:Name="SheetIcon" Symbol="Flash24" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </DockPanel>
        <TextBlock x:Name="SuiteTitleText" Text="문자 판정 시험" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <TextBlock x:Name="SuiteDescriptionText" Style="{StaticResource HintText}" FontSize="13" Margin="0,4,0,0"/>
        <ui:InfoBar x:Name="SheetError" Style="{StaticResource NoticeBar}" Severity="Error" IsOpen="False" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"/>
        <TextBlock Text="시험 종류" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/>
        <UniformGrid x:Name="SuitePanel" Columns="2" Margin="-12,0,0,0">
         <RadioButton x:Name="VerdictSuiteRadio" GroupName="Suite" IsChecked="True" Tag="verdict" Content="문자 판정" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="verdict"/>
         <RadioButton x:Name="PipelineSuiteRadio" GroupName="Suite" Tag="pipeline" Content="데이터 처리" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="pipeline"/>
         <RadioButton x:Name="LoadSuiteRadio" GroupName="Suite" Tag="load" Content="부하·응답" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="load"/>
         <RadioButton x:Name="RecoverySuiteRadio" GroupName="Suite" Tag="recovery" Content="중단 후 복구" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="recovery"/>
         <RadioButton x:Name="SelfCheckSuiteRadio" GroupName="Suite" Tag="selfcheck" Content="QA 도구 점검" Checked="SuiteRadio_Checked" Style="{StaticResource SuiteNavigation}" local:UsageHelp.Key="selfcheck"/>
        </UniformGrid>
        <Border x:Name="ExecutionOptions" Background="Transparent"><StackPanel>
         <StackPanel x:Name="TargetChoicePanel"><TextBlock Text="시험 대상" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><WrapPanel><RadioButton x:Name="PracticeTargetRadio" GroupName="Target" Content="연습용 대상" IsChecked="True" Checked="Target_Checked" Style="{StaticResource TargetChoice}" Margin="0,0,16,0"/><RadioButton x:Name="ApiTargetRadio" GroupName="Target" Content="내 판정 API" Checked="Target_Checked" Style="{StaticResource TargetChoice}" local:UsageHelp.Key="api"/></WrapPanel></StackPanel>
         <StackPanel x:Name="ExecutionApiField" Visibility="Collapsed"><TextBlock Text="판정 API 주소" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="ApiUrlBox" PlaceholderText="http://localhost:8000" TextChanged="EnvironmentField_Changed" local:UsageHelp.Key="api"/></StackPanel>
         <TextBlock x:Name="ApiUrlHint" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
         <StackPanel x:Name="CasesPathField"><TextBlock x:Name="CasesPathLabel" Text="시험 문자와 예상 정답" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="CasesPathBox" TextChanged="EnvironmentField_Changed" local:UsageHelp.Key="case-path"/></StackPanel>
         <StackPanel x:Name="MeasurementPanel" Visibility="Collapsed"><UniformGrid Columns="3">
          <StackPanel Margin="0,0,6,0"><TextBlock Text="시간 (초)" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="DurationBox" TextChanged="SheetDuration_Changed" local:UsageHelp.Key="duration"/></StackPanel>
          <StackPanel Margin="3,0"><TextBlock Text="초당 건수" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="RateBox" local:UsageHelp.Key="rate"/></StackPanel>
          <StackPanel x:Name="StopSecondsField" Margin="6,0,0,0"><TextBlock Text="중단 (초)" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/><ui:TextBox x:Name="StopSecondsBox" local:UsageHelp.Key="stop"/></StackPanel>
         </UniformGrid><TextBlock x:Name="MeasurementHint" Style="{StaticResource HintText}" Margin="0,8,0,0"/></StackPanel>
         <TextBlock Text="보고서 저장 위치" Style="{StaticResource SectionLabel}" FontWeight="SemiBold"/>
         <ui:TextBox x:Name="ReportDirectoryBox" Text="reports" local:UsageHelp.Key="report-path"/>
        </StackPanel></Border>
        <Border x:Name="SheetPracticeNote" Background="{StaticResource AccentBackgroundBrush}" CornerRadius="16" Padding="14,12" Margin="0,20,0,0">
         <DockPanel><ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/><TextBlock Text="연습용 대상에는 일부러 틀리는 규칙이 있어요. 어떤 차이를 찾아내는지 살펴보세요." TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource CalloutInkBrush}"/></DockPanel>
        </Border>
       </StackPanel></ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid></Grid>
  <!-- 상태 표시줄: 시험이 끝나면 결과에 따라 초록·주황·빨강 띠로 바뀌고 보고서 바로가기를 보여 준다 -->
  <Border x:Name="StatusBarBorder" Grid.Row="2" MinHeight="28" BorderThickness="0,2,0,0" BorderBrush="Transparent" Background="Transparent">
   <DockPanel Margin="16,0">
    <TextBlock x:Name="ZoomStatusText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,16,0" local:UsageHelp.Key="zoom"/>
    <StackPanel x:Name="StatusActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,4,0,4">
     <ui:Button Content="보고서 열기" Click="OpenReportButton_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsEnabled, ElementName=OpenReportButton}" MinHeight="28" Padding="10,2" Margin="0,0,8,0" local:UsageHelp.Key="open-report"/>
     <ui:Button Content="폴더 열기" Click="OpenReportFolder_Click" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="10,2"/>
    </StackPanel>
    <Border x:Name="StatusIconBadge" Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"><ui:SymbolIcon x:Name="StatusIcon" Symbol="Checkmark24" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock x:Name="StatusText" Text="홈에서 ‘다음 할 일’을 따라가 보세요." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   </DockPanel>
  </Border>
  <ResizeGrip Grid.Row="2" Style="{StaticResource WindowResizeGrip}"/>
 </Grid>
</Window>
