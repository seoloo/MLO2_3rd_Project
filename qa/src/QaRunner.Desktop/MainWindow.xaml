<Window x:Class="QaRunner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="정보지킴 QA 러너"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Noto Sans KR, Malgun Gothic" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="White">

    <Window.Resources>
        <!-- 왼쪽 설정 칸의 소제목 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- 입력 칸 밑의 작은 설명 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- 실행 버튼 (색이 채워진 버튼) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 보고서 열기 버튼 (테두리만 있는 버튼) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="White" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 요약 숫자 칸 (전체·통과·실패·통과율) -->
        <Style x:Key="SummaryTile" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리말 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="JEONGBO JIKIM / QA RUNNER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="정보지킴 QA 러너" FontSize="26" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBlock Text="시험을 골라 실행하면, 정답과 비교한 결과를 바로 보여 주고 보고서를 저장합니다."
                       Foreground="{StaticResource MutedBrush}" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 실행 설정 -->
            <Border Grid.Column="0" Background="{StaticResource AccentBackgroundBrush}" CornerRadius="12" Padding="18,4,18,18">
                <StackPanel>
                    <TextBlock Text="시험 종류" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="VerdictSuiteRadio" GroupName="Suite" IsChecked="True" Checked="SuiteRadio_Checked"
                                 Content="판정 시험  (문자 → 판정)"/>
                    <RadioButton x:Name="PipelineSuiteRadio" GroupName="Suite" Checked="SuiteRadio_Checked"
                                 Content="파이프라인 시험  (이벤트 → 집계)"/>

                    <TextBlock x:Name="CasesPathLabel" Text="입력값 파일" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="CasesPathBox"/>

                    <TextBlock Text="판정 API 주소" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ApiUrlBox"/>
                    <TextBlock x:Name="ApiUrlHint" Text="비워 두면 가짜 판정 대상으로 실행합니다." Style="{StaticResource HintText}"/>

                    <TextBlock Text="보고서 폴더" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ReportDirectoryBox" Text="reports"/>

                    <Button x:Name="RunButton" Content="실행" Style="{StaticResource PrimaryButton}"
                            Margin="0,22,0,0" Click="RunButton_Click"/>
                    <Button x:Name="OpenReportButton" Content="HTML 보고서 열기" Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0" IsEnabled="False" Click="OpenReportButton_Click"/>

                    <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 오른쪽: 결과 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="RunInfoText" Grid.Row="0" Foreground="{StaticResource MutedBrush}"
                           Text="아직 실행하지 않았습니다." Margin="0,0,0,10"/>

                <!-- 가짜 시험 대상으로 돌렸을 때만 보이는 안내 -->
                <Border x:Name="FakeTargetNotice" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12"
                        Background="{StaticResource NoticeBackgroundBrush}" CornerRadius="8" Padding="12,9">
                    <TextBlock Text="가짜 시험 대상으로 실행한 결과입니다. 실제 시스템의 성능이 아닙니다."
                               Foreground="{StaticResource NoticeBrush}"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,-10,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SummaryTile}">
                        <StackPanel>
                            <TextBlock Text="전체" Style="{StaticResource TileLabel}"/>
                            <TextBlock x:Name="TotalCountText" Text="-" Style="{StaticResource TileValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SummaryTile}">
                        <StackPanel>
                            <TextBlock Text="통과" Style="{StaticResource TileLabel}"/>
                            <TextBlock x:Name="PassedCountText" Text="-" Style="{StaticResource TileValue}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SummaryTile}">
                        <StackPanel>
                            <TextBlock Text="실패" Style="{StaticResource TileLabel}"/>
                            <TextBlock x:Name="FailedCountText" Text="-" Style="{StaticResource TileValue}" Foreground="{StaticResource FailBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SummaryTile}">
                        <StackPanel>
                            <TextBlock Text="통과율" Style="{StaticResource TileLabel}"/>
                            <TextBlock x:Name="PassRateText" Text="-" Style="{StaticResource TileValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 결과 표: 실패한 항목이 위로, 실패한 줄은 붉게 -->
                <DataGrid x:Name="ResultsGrid" Grid.Row="3"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                          Background="White" RowBackground="White" SelectionUnit="FullRow">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6FAF9"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource FailRowBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="케이스" Binding="{Binding CaseId}" Width="110" FontWeight="Bold"/>
                        <DataGridTextColumn Header="확인 항목" Binding="{Binding CheckName}" Width="140"/>
                        <DataGridTextColumn Header="입력" Binding="{Binding Input}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="정답" Binding="{Binding Expected}" Width="100"/>
                        <DataGridTextColumn Header="실제" Binding="{Binding ActualDisplay}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="결과" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ResultBadge" CornerRadius="9" Padding="9,2" HorizontalAlignment="Left"
                                            Background="{StaticResource PassBackgroundBrush}">
                                        <TextBlock x:Name="ResultBadgeText" Text="{Binding ResultLabel}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource FailBackgroundBrush}"/>
                                            <Setter TargetName="ResultBadgeText" Property="Foreground" Value="{StaticResource FailBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
