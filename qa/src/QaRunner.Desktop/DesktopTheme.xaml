<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- WPF UI Light 컨트롤 + Stone·Teal 색 조합 (Tailwind CSS 기본 팔레트의 stone·teal 계열). -->
    <!-- 배경은 4단계만 쓴다: 사이드바 #F5F5F4 · 앱 배경 #FAFAF9 · 카드 #FFFFFF · 호버 #EFEDEB. 선택은 청록 옅은 바탕 #E0F2EF. -->
    <!-- 간격은 8·12·16·24·32, 글자 크기는 12·13·14·16·20·26만 쓴다. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#E0F2EF"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="ContextBarBrush" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="ContextWorkspaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContextLineBrush" Color="#E7E5E4"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EFEDEB"/>
    <SolidColorBrush x:Key="CaptionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CaptionInkBrush" Color="#1C1917"/>
    <SolidColorBrush x:Key="CaptionMutedBrush" Color="#78716C"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#EFEDEB"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1C1917"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#78716C"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E7E5E4"/>
    <SolidColorBrush x:Key="PassBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="PassBackgroundBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="FailBrush" Color="#BE123C"/>
    <SolidColorBrush x:Key="FailBackgroundBrush" Color="#FFE4E6"/>
    <SolidColorBrush x:Key="FailRowBrush" Color="#FFF1F2"/>
    <SolidColorBrush x:Key="NoticeBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFAF9"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#E0F2EF"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#A8A29E"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E7E5E4"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="IntroBackgroundBrush" Color="#0D9488"/>
    <DropShadowEffect x:Key="CardShadow" Color="#1C1917" BlurRadius="12" ShadowDepth="1" Opacity="0.04"/>
    <SolidColorBrush x:Key="GuideBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GuideAccentBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="CalloutBackgroundBrush" Color="#E0F2EF"/>
    <SolidColorBrush x:Key="CalloutInkBrush" Color="#115E59"/>
    <SolidColorBrush x:Key="ActionBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="ActionBackgroundBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <!-- 밝은 화면 위에서도 잘 보이도록 말풍선은 짙은 바탕 + 흰 글씨. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#292524"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14"/><Setter Property="MaxWidth" Value="350"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                <ContentPresenter/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DesktopWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="BorderBrush" Value="#D6D3D1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value>
            <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                                CornerRadius="0" UseAeroCaptionButtons="False"/>
        </Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                <AdornerDecorator><ContentPresenter/></AdornerDecorator>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter Property="BorderThickness" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WindowResizeGrip" TargetType="ResizeGrip">
        <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="shell:WindowChrome.ResizeGripDirection" Value="BottomRight"/>
        <Setter Property="ToolTip" Value="드래그하여 창 크기 조절"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
    <!-- 카드 제목(16)과 카드 안 작은 숫자 카드. -->
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="Padding" Value="16,12"/></Style>
    <!-- 아이콘을 담는 옅은 청록 원. -->
    <Style x:Key="IconCircle" TargetType="Border"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <!-- 버튼은 기본(Primary)·보조(Secondary)·텍스트(Text) 세 단계로, 높이 36과 모서리 6을 함께 쓴다. -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="16,6"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style x:Key="WorkspaceButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"/>
    <!-- WPF UI의 Primary 버튼은 Windows 강조색을 쓰므로, 앱의 청록 한 가지로 덮어써 흰 글씨와 대비를 맞춘다. -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0D9488"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0F766E"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#115E59"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#115E59"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF"/>
        </Style.Resources>
        <Setter Property="Appearance" Value="Primary"/><Setter Property="Background" Value="{StaticResource ActionBackgroundBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="TextButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Appearance" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <!-- 목록에서 고른 줄: 옅은 청록 바탕과 왼쪽 강조선. -->
    <Style x:Key="SelectableListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,0,0,8">
                <Border x:Name="ItemSurface" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter/></Border>
                <Border x:Name="ItemRail" Width="3" Margin="0,12" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBackgroundBrush}"/><Setter TargetName="ItemRail" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 정답 상태처럼 짧은 상태를 보여 주는 작은 배지. -->
    <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{StaticResource NoticeBackgroundBrush}"/></Style>
    <!-- 페이지 머리말: 제목 26, 설명 13, 아래 간격 24로 모든 화면에서 같은 위치에 둔다. -->
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style x:Key="PageHeader" TargetType="FrameworkElement"><Setter Property="Margin" Value="0,0,0,24"/></Style>
    <!-- 목록이 비었을 때 빈 줄 대신 보여 주는 안내 문구. -->
    <Style x:Key="EmptyListText" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="24"/></Style>
    <!-- 숫자 칸(건수·시간)은 오른쪽으로 맞춘다. -->
    <Style x:Key="NumberCell" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
    <!-- 긴 값은 말줄임으로 자르고 전체 값은 도움말로 보여 준다. -->
    <Style x:Key="TrimmedCell" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style x:Key="TabNavigation" TargetType="RadioButton">
        <Setter Property="Padding" Value="18,13"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Height="64" Margin="8,4">
                <Border x:Name="NavSurface" CornerRadius="8" Background="Transparent" Padding="2,8">
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NavIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                    <ContentPresenter HorizontalAlignment="Center" Margin="0,8,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/></Style></ContentPresenter.Resources></ContentPresenter></StackPanel>
                </Border>
                <Border x:Name="SelectionRail" Width="3" Height="24" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="1,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="run"><Setter TargetName="NavIcon" Property="Text" Value="&#xE768;"/></Trigger>
                <Trigger Property="Tag" Value="cases"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8A5;"/></Trigger>
                <Trigger Property="Tag" Value="team"><Setter TargetName="NavIcon" Property="Text" Value="&#xE716;"/></Trigger>
                <Trigger Property="Tag" Value="reports"><Setter TargetName="NavIcon" Property="Text" Value="&#xE81C;"/></Trigger>
                <Trigger Property="Tag" Value="settings"><Setter TargetName="NavIcon" Property="Text" Value="&#xE713;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource NavigationSelectedBrush}"/><Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/><Setter TargetName="NavIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 시작하기의 시험 카드: 아이콘 원 + 이름·설명·최근 결과 + 화살표. 고른 카드는 청록 테두리. -->
    <Style x:Key="QuestionChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <!-- 카드 사이 간격 16: 양쪽 8씩 두고 부모에서 -8로 바깥 선을 본문과 맞춘다. -->
            <Grid Margin="8">
                <Border x:Name="Surface" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Effect="{StaticResource CardShadow}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconCircle}" VerticalAlignment="Top"><TextBlock x:Name="ChoiceIcon" Style="{StaticResource IconGlyph}" Text="&#xE8A5;"/></Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
                <Border x:Name="SelectedRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="pipeline"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE8B7;"/></Trigger>
                <Trigger Property="Tag" Value="load"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE9D9;"/></Trigger>
                <Trigger Property="Tag" Value="recovery"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE72C;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AppBackgroundBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectedRing" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TargetChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
    <!-- 시험하기 상단의 한 줄 묶음 버튼(세그먼트). Tag로 아이콘을 고른다. -->
    <Style x:Key="SuiteNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Item" CornerRadius="8" Background="Transparent" Padding="12,8" Margin="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="SuiteIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="pipeline"><Setter TargetName="SuiteIcon" Property="Text" Value="&#xE8B7;"/></Trigger>
                <Trigger Property="Tag" Value="load"><Setter TargetName="SuiteIcon" Property="Text" Value="&#xE9D9;"/></Trigger>
                <Trigger Property="Tag" Value="recovery"><Setter TargetName="SuiteIcon" Property="Text" Value="&#xE72C;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="RowBackground" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="MinRowHeight" Value="40"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource ToolbarBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow"><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
