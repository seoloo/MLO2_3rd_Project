<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- WPF UI Dark 컨트롤과 2.0.3 Gallery 원본 배경. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#39A9F5"/>
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#263B50"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#2B2B39"/>
    <SolidColorBrush x:Key="ContextBarBrush" Color="#242432"/>
    <SolidColorBrush x:Key="ContextWorkspaceBrush" Color="#30303E"/>
    <SolidColorBrush x:Key="ContextLineBrush" Color="#454553"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#20202D"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#353543"/>
    <SolidColorBrush x:Key="CaptionBrush" Color="#1C222D"/>
    <SolidColorBrush x:Key="CaptionInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CaptionMutedBrush" Color="#C9CBD1"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#333A47"/>
    <SolidColorBrush x:Key="InkBrush" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#BDC0CB"/>
    <SolidColorBrush x:Key="LineBrush" Color="#424250"/>
    <SolidColorBrush x:Key="PassBrush" Color="#87D6B0"/>
    <SolidColorBrush x:Key="PassBackgroundBrush" Color="#254236"/>
    <SolidColorBrush x:Key="FailBrush" Color="#FF9DAB"/>
    <SolidColorBrush x:Key="FailBackgroundBrush" Color="#4B2D36"/>
    <SolidColorBrush x:Key="FailRowBrush" Color="#382A32"/>
    <SolidColorBrush x:Key="NoticeBrush" Color="#E9CB85"/>
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#423C2D"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#292936"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#35303F"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#767685"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#39394A"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#20202D"/>
    <SolidColorBrush x:Key="IntroBackgroundBrush" Color="#2C877B"/>
    <DropShadowEffect x:Key="CardShadow" Color="#35416A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
    <SolidColorBrush x:Key="GuideBackgroundBrush" Color="#30303E"/>
    <SolidColorBrush x:Key="GuideAccentBrush" Color="#79CBC3"/>
    <SolidColorBrush x:Key="CalloutBackgroundBrush" Color="#253D3C"/>
    <SolidColorBrush x:Key="CalloutInkBrush" Color="#A0DED4"/>
    <SolidColorBrush x:Key="ActionBrush" Color="#43AAF1"/>
    <SolidColorBrush x:Key="ActionBackgroundBrush" Color="#087ABE"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#343440"/>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CaptionBrush}"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14"/><Setter Property="MaxWidth" Value="350"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                <ContentPresenter/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DesktopWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value>
            <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                                CornerRadius="0" UseAeroCaptionButtons="False"/>
        </Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                <AdornerDecorator><ContentPresenter/></AdornerDecorator>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter Property="BorderThickness" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WindowResizeGrip" TargetType="ResizeGrip">
        <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="shell:WindowChrome.ResizeGripDirection" Value="BottomRight"/>
        <Setter Property="ToolTip" Value="드래그하여 창 크기 조절"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,7"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
    <Style x:Key="SecondaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style x:Key="WorkspaceButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"/>
    <Style x:Key="PrimaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Appearance" Value="Primary"/><Setter Property="Background" Value="{StaticResource ActionBackgroundBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TabNavigation" TargetType="RadioButton">
        <Setter Property="Padding" Value="18,13"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource ToolbarBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Height="66" Margin="4,3">
                <Border x:Name="NavSurface" CornerRadius="6" Background="Transparent" Padding="2,8">
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NavIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="22" HorizontalAlignment="Center"/>
                    <ContentPresenter HorizontalAlignment="Center" Margin="0,7,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="10"/></Style></ContentPresenter.Resources></ContentPresenter></StackPanel>
                </Border>
                <Border x:Name="SelectionRail" Width="3" Height="24" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="1,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="run"><Setter TargetName="NavIcon" Property="Text" Value="&#xE768;"/></Trigger>
                <Trigger Property="Tag" Value="cases"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8A5;"/></Trigger>
                <Trigger Property="Tag" Value="team"><Setter TargetName="NavIcon" Property="Text" Value="&#xE716;"/></Trigger>
                <Trigger Property="Tag" Value="reports"><Setter TargetName="NavIcon" Property="Text" Value="&#xE81C;"/></Trigger>
                <Trigger Property="Tag" Value="settings"><Setter TargetName="NavIcon" Property="Text" Value="&#xE713;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource NavigationSelectedBrush}"/><Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/><Setter TargetName="NavIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuestionChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Margin="4,0" MinHeight="90">
                <ui:Card x:Name="Surface" Background="{StaticResource CardBackgroundBrush}" Padding="14,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChoiceIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="23" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="22" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>
                <Border x:Name="ChoiceRail" Height="3" Margin="9,0" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="pipeline"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE8B7;"/></Trigger>
                <Trigger Property="Tag" Value="load"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE9D9;"/></Trigger>
                <Trigger Property="Tag" Value="recovery"><Setter TargetName="ChoiceIcon" Property="Text" Value="&#xE72C;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceRail" Property="Visibility" Value="Visible"/><Setter TargetName="Surface" Property="Background" Value="#383846"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TargetChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style x:Key="SuiteNavigation" TargetType="RadioButton" BasedOn="{StaticResource TabNavigation}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Item" CornerRadius="8" Margin="4" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="8,7" Background="{StaticResource CardBackgroundBrush}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="RowBackground" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="MinRowHeight" Value="38"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource ToolbarBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
