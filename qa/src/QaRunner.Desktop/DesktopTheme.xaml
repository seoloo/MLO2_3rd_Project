<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Windows 11 설정 앱 스타일: 창·메뉴·본문이 같은 바탕(#F4F6F9) 위에 있고, 묶음만 흰 카드(그림자 없음, 1px 선)로 올린다. -->
    <!-- 강조색은 남보라 #4F46E5 하나 (Slate·Indigo, Tailwind CSS slate·indigo 계열). 간격 4·8·12·16·24·32, 글자 12·13·14·16·20·26. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ContextBarBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="ContextWorkspaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContextLineBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9EEF4"/>
    <SolidColorBrush x:Key="CaptionBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="CaptionInkBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CaptionMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InkBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="PassBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="PassBackgroundBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="FailBrush" Color="#BE123C"/>
    <SolidColorBrush x:Key="FailBackgroundBrush" Color="#FFE4E6"/>
    <SolidColorBrush x:Key="FailRowBrush" Color="#FFF1F2"/>
    <SolidColorBrush x:Key="NoticeBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="IntroBackgroundBrush" Color="#4F46E5"/>
    <DropShadowEffect x:Key="CardShadow" Color="#0F172A" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <SolidColorBrush x:Key="GuideBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GuideAccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="CalloutBackgroundBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="CalloutInkBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="ActionBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="ActionBackgroundBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <!-- 밝은 화면 위에서도 잘 보이도록 말풍선은 짙은 바탕 + 흰 글씨. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/><Setter Property="MaxWidth" Value="340"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                <ContentPresenter/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DesktopWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value>
            <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                                CornerRadius="0" UseAeroCaptionButtons="False"/>
        </Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                <AdornerDecorator><ContentPresenter/></AdornerDecorator>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter Property="BorderThickness" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WindowResizeGrip" TargetType="ResizeGrip">
        <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="shell:WindowChrome.ResizeGripDirection" Value="BottomRight"/>
        <Setter Property="ToolTip" Value="드래그하여 창 크기 조절"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>

    <!-- 글자 -->
    <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
    <!-- 묶음 이름: 카드 바깥 위에 두는 14 SemiBold (Windows 11 설정 앱과 같은 위치) -->
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,24,0,8"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    <Style x:Key="PageHeader" TargetType="FrameworkElement"><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="EmptyListText" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="24"/></Style>
    <Style x:Key="NumberCell" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
    <Style x:Key="TrimmedCell" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>

    <!-- 카드: 흰 바탕 + 1px 선, 그림자 없음 -->
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="Padding" Value="16,12"/></Style>
    <Style x:Key="IconCircle" TargetType="Border"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <!-- 설정 줄(CardControl)은 4px 간격으로 붙여 하나의 묶음처럼 보이게 한다 -->
    <Style x:Key="SettingCard" TargetType="{x:Type ui:CardControl}" BasedOn="{StaticResource {x:Type ui:CardControl}}"><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="64"/></Style>
    <Style x:Key="SettingName" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6,1"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{StaticResource NoticeBackgroundBrush}"/></Style>

    <!-- 버튼: 기본(Primary)·보조(Secondary)·텍스트(Text). 높이 32, 모서리 4 (Windows 11 기본 크기). -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,4"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style x:Key="WorkspaceButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"/>
    <Style x:Key="PrimaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#4F46E5"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4338CA"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3730A3"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#3730A3"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF"/>
        </Style.Resources>
        <Setter Property="Appearance" Value="Primary"/><Setter Property="Background" Value="{StaticResource ActionBackgroundBrush}"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="TextButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Appearance" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>

    <Style x:Key="SelectableListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,0,0,4">
                <Border x:Name="ItemSurface" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter/></Border>
                <Border x:Name="ItemRail" Width="3" Margin="0,12" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource ToolbarBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/><Setter TargetName="ItemRail" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TabNavigation" TargetType="RadioButton">
        <Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 왼쪽 메뉴: Windows 11 탐색 창처럼 아이콘 + 이름 한 줄, 고르면 옅은 회색 바탕 + 왼쪽 짧은 남보라 막대 -->
    <Style x:Key="SidebarNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Height="40" Margin="8,2">
                <Border x:Name="NavSurface" CornerRadius="4" Background="Transparent"/>
                <Border x:Name="SelectionRail" Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="NavIcon" Symbol="Home24" FontSize="18" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="run"><Setter TargetName="NavIcon" Property="Symbol" Value="Play24"/></Trigger>
                <Trigger Property="Tag" Value="cases"><Setter TargetName="NavIcon" Property="Symbol" Value="Wrench24"/></Trigger>
                <Trigger Property="Tag" Value="team"><Setter TargetName="NavIcon" Property="Symbol" Value="PeopleTeam24"/></Trigger>
                <Trigger Property="Tag" Value="reports"><Setter TargetName="NavIcon" Property="Symbol" Value="History24"/></Trigger>
                <Trigger Property="Tag" Value="settings"><Setter TargetName="NavIcon" Property="Symbol" Value="Settings24"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource NavigationSelectedBrush}"/><Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/><Setter TargetName="NavIcon" Property="Filled" Value="True"/><Setter TargetName="NavIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 시작하기 시험 카드: 흰 카드, 아이콘 + 이름 + 한 줄 설명 + 최근 결과. 고르면 남보라 테두리. -->
    <Style x:Key="QuestionChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <!-- 카드 사이 간격 8: 양쪽 4씩 두고 부모에서 -4로 바깥 선을 본문과 맞춘다. -->
            <Grid Margin="4">
                <Border x:Name="Surface" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="ChoiceIcon" Symbol="DocumentText24" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="SelectedRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="pipeline"><Setter TargetName="ChoiceIcon" Property="Symbol" Value="DataTrending24"/></Trigger>
                <Trigger Property="Tag" Value="load"><Setter TargetName="ChoiceIcon" Property="Symbol" Value="Gauge24"/></Trigger>
                <Trigger Property="Tag" Value="recovery"><Setter TargetName="ChoiceIcon" Property="Symbol" Value="ArrowClockwise24"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ToolbarBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectedRing" Property="Visibility" Value="Visible"/><Setter TargetName="ChoiceIcon" Property="Filled" Value="True"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TargetChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
    <!-- 시험 종류 묶음 버튼: Windows 11 SelectorBar처럼 글자 + 아래 짧은 남보라 막대 -->
    <Style x:Key="SuiteNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Margin="0,0,4,0">
                <Border x:Name="Item" CornerRadius="4" Background="Transparent" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="SuiteIcon" Symbol="DocumentText24" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="Indicator" Height="3" Width="20" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="pipeline"><Setter TargetName="SuiteIcon" Property="Symbol" Value="DataTrending24"/></Trigger>
                <Trigger Property="Tag" Value="load"><Setter TargetName="SuiteIcon" Property="Symbol" Value="Gauge24"/></Trigger>
                <Trigger Property="Tag" Value="recovery"><Setter TargetName="SuiteIcon" Property="Symbol" Value="ArrowClockwise24"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="SuiteIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="SuiteIcon" Property="Filled" Value="True"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 기록·관리 안쪽 탭: 글자 + 아래 짧은 막대 (아이콘 없음) -->
    <Style x:Key="SubTabNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Margin="0,0,4,0">
                <Border x:Name="Item" CornerRadius="4" Background="Transparent" Padding="12,8"><ContentPresenter/></Border>
                <Border x:Name="Indicator" Height="3" Width="20" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 빠른 시작 카드: 누르면 바로 시험. 둥근 모서리 12로 부드럽게. -->
    <Style x:Key="PresetCard" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16,14">
                <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ToolbarBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentBackgroundBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RecommendedPresetCard" TargetType="Button" BasedOn="{StaticResource PresetCard}"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <!-- 카드 안 작은 알약 (걸리는 시간 등) -->
    <Style x:Key="Chip" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/><Setter Property="Background" Value="{StaticResource HoverBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <!-- 표: 카드 안에 넣고 테두리 없이, 머리줄은 아래 선 하나만 -->
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="RowBackground" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="MinRowHeight" Value="40"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
