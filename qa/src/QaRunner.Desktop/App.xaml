<Application x:Class="QaRunner.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 창은 App.xaml.cs의 OnStartup에서 직접 띄운다 (화면 캡처 모드 때문) -->
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F7A73"/>
        <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#EAF5F2"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1D3436"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F7173"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D6E4E1"/>
        <SolidColorBrush x:Key="PassBackgroundBrush" Color="#E2F3EE"/>
        <SolidColorBrush x:Key="FailBrush" Color="#B4232A"/>
        <SolidColorBrush x:Key="FailBackgroundBrush" Color="#FDECEC"/>
        <SolidColorBrush x:Key="FailRowBrush" Color="#FFF8F8"/>
        <SolidColorBrush x:Key="NoticeBrush" Color="#8A5A12"/>
        <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FDF4E7"/>
    </Application.Resources>
</Application>
