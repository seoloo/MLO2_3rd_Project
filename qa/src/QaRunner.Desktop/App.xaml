<Application x:Class="QaRunner.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 창은 App.xaml.cs의 OnStartup에서 직접 띄운다 (화면 캡처 모드 때문) -->
    <Application.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ui:ThemesDictionary Theme="Dark"/><ui:ControlsDictionary/><ResourceDictionary Source="DesktopTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Application.Resources>
</Application>
