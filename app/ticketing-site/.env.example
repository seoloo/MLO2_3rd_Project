# Server environment example; not automatically loaded by Django.
# Export values in your shell or load through a systemd EnvironmentFile.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_COOKIE_SECURE=1
DJANGO_SSL_REDIRECT=1
DJANGO_TRUST_PROXY_HEADERS=1
# Optional shared PostgreSQL. Without POSTGRES_HOST, development uses SQLite.
POSTGRES_HOST=your-database-host
POSTGRES_DB=ticketguard
POSTGRES_USER=ticketguard
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
