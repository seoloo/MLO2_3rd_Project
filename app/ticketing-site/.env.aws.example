# Copy to .env.aws. Use a real EC2 public IP or domain. Never use *.
DJANGO_SECRET_KEY=replace-with-unique-random-secret
POSTGRES_PASSWORD=replace-with-unique-random-password
DJANGO_ALLOWED_HOSTS=YOUR_EC2_IP,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_IP
WEB_WORKERS=2
TG_RUN_ID=baseline
